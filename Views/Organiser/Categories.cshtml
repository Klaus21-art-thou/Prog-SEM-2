@model CategoriesPageModel
@{
    ViewData["Title"] = "Categories";
    ViewData["Active"] = "Categories";
}

<partial name="_EventNav" />

@if (ViewBag.ErrorMessage != null)
{
    <p role="alert" class="alert alert-warning">@ViewBag.ErrorMessage</p>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h4 mb-0">Race categories</h2>
    <a class="btn btn-primary" asp-action="CreateCategory" asp-route-eventId="@Model.Event.EventId">Add category</a>
</div>

@if (!Model.Categories.Any())
{
    <p>This event has no categories yet. Add one, for example "10km Road Run".</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Category</th>
                    <th scope="col" class="text-end">Distance</th>
                    <th scope="col" class="text-end">Entry fee</th>
                    <th scope="col" class="text-end">Max participants</th>
                    <th scope="col">Starts</th>
                    <th scope="col" class="text-end">Min age</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td>
                            <strong>@c.CategoryName</strong>
                            @if (!string.IsNullOrWhiteSpace(c.RouteDescription))
                            {
                                <br />
                    
                                <span class="text-muted small">@c.RouteDescription</span>
                            }
                        </td>
                        <td class="text-end">@c.DistanceKm.ToString("0.##") km</td>
                        <td class="text-end">R @c.EntryFee.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td class="text-end">@c.MaxParticipants</td>
                        <td>@c.StartDateTime.ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end">@(c.MinAge?.ToString() ?? "-")</td>
                        <td class="text-nowrap text-end">
                            <a asp-action="EditCategory" asp-route-id="@c.CategoryId">Edit</a> |
                            <a asp-action="DeleteCategory" asp-route-id="@c.CategoryId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}