@model VenueFormViewModel
@{
    ViewData["Title"] = "Add venue";
}

<h1>Add a venue</h1>
<p>A venue is the location where an event takes place.</p>

<form asp-action="CreateVenue" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Province" class="form-label"></label>
            <input asp-for="Province" class="form-control" />
            <span asp-validation-for="Province" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add venue</button>
    <a class="btn btn-outline-secondary" asp-action="CreateEvent">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}