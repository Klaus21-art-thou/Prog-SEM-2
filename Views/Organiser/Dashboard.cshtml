@using RaceDay.MVC.Services
@model DashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
}

<h1>Organiser dashboard</h1>
<p>Welcome, @Context.Session.GetString(SessionKeys.UserName).</p>

@if (ViewBag.ErrorMessage != null)
{
    <p role="alert" class="alert alert-warning">@ViewBag.ErrorMessage</p>
}

@* Summary figures *@
<section aria-label="Summary" class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="border rounded p-3 h-100">
            <p class="text-muted mb-1">My events</p>
            <p class="fs-2 fw-bold mb-0">@Model.TotalEvents</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="border rounded p-3 h-100">
            <p class="text-muted mb-1">Upcoming events</p>
            <p class="fs-2 fw-bold mb-0">@Model.UpcomingCount</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="border rounded p-3 h-100">
            <p class="text-muted mb-1">Total enrolments</p>
            <p class="fs-2 fw-bold mb-0">@Model.TotalEnrolments</p>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="border rounded p-3 h-100">
            <p class="text-muted mb-1">Pending enrolments</p>
            <p class="fs-2 fw-bold mb-0">@Model.PendingEnrolments</p>
        </div>
    </div>
</section>

@* Upcoming dates *@
<section aria-labelledby="upcoming-heading" class="mb-4">
    <h2 id="upcoming-heading" class="h4">Upcoming dates</h2>
    @if (!Model.UpcomingEvents.Any())
    {
        <p>You have no upcoming events. <a asp-action="CreateEvent">Create one</a>.</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var ev in Model.UpcomingEvents)
            {
                <li class="mb-1">
                    <strong>@ev.EventDate.ToString("ddd, dd MMM yyyy, HH:mm")</strong> &ndash; @ev.Title
                    @if (ev.Venue != null)
                    {
                        <span class="text-muted">(@ev.Venue.Name, @ev.Venue.City)</span>
                    }
                </li>
            }
        </ul>
    }
</section>

@* Enrolments per event *@
<section aria-labelledby="events-heading">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 id="events-heading" class="h4 mb-0">Enrolments per event</h2>
        <a class="btn btn-primary" asp-action="CreateEvent">Create event</a>
    </div>

    @if (!Model.Rows.Any())
    {
        <p>You have not created any events yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Date</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Categories</th>
                        <th scope="col" class="text-end">Enrolments</th>
                        <th scope="col" class="text-end">Pending</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Event.Title</td>
                            <td>@row.Event.EventDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge @UiHelper.StatusClass(row.Event.Status)">@row.Event.Status</span></td>
                            <td class="text-end">@row.Categories</td>
                            <td class="text-end">@row.Enrolments</td>
                            <td class="text-end">@row.Pending</td>
                            <td class="text-end"><a asp-action="Enrolments" asp-route-eventId="@row.Event.EventId">View enrolments</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>