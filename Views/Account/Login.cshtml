@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

<form asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    @* Errors that belong to the whole form, such as "Invalid email or password." *@
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Log in</button>
</form>

<p class="mt-3">New to RaceDay? <a asp-action="Register">Create an account</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}